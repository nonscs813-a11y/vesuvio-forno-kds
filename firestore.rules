rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tenant isolation: only an authenticated admin of THIS site may read/update/delete.
    function isSiteAdmin(site) {
      return request.auth != null
        && request.auth.token.site == site
        && request.auth.token.role == 'site_admin';
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['cliente', 'contato', 'profissional', 'servico', 'horario', 'valor', 'status', 'lgpdConsent', 'integrityHash'])
        && data.cliente is string && data.cliente.size() >= 2 && data.cliente.size() <= 120
        && data.contato is string && data.contato.size() >= 4 && data.contato.size() <= 120
        && data.profissional is string && data.profissional.size() >= 2 && data.profissional.size() <= 120
        && data.servico is string && data.servico.size() >= 2 && data.servico.size() <= 160
        && data.horario is string && data.horario.size() >= 2 && data.horario.size() <= 80
        && data.valor is string && data.valor.size() >= 3 && data.valor.size() <= 40
        && data.status in ['Confirmado', 'Em Atendimento', 'Concluído']
        && data.lgpdConsent == true
        && data.integrityHash is string && data.integrityHash.size() == 20;
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['action', 'detail', 'at'])
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 60
        && data.detail is string && data.detail.size() <= 500
        && data.at is timestamp;
    }

    // kronos-barber-club
    match /agendamentos_barbearia/{docId} {
      allow get, list: if isSiteAdmin('kronos-barber-club');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('kronos-barber-club');
    }


    // lumina-odonto-clinic
    match /consultas_odontovida/{docId} {
      allow get, list: if isSiteAdmin('lumina-odonto-clinic');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('lumina-odonto-clinic');
    }


    // vesuvio-forno-kds
    match /pedidos_pizzaria/{docId} {
      allow get, list: if isSiteAdmin('vesuvio-forno-kds');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('vesuvio-forno-kds');
    }


    // valkyrie-autotech-os
    match /ordens_servico_oficina/{docId} {
      allow get, list: if isSiteAdmin('valkyrie-autotech-os');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('valkyrie-autotech-os');
    }


    // vertice-estates-crm
    match /visitas_imobiliaria/{docId} {
      allow get, list: if isSiteAdmin('vertice-estates-crm');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('vertice-estates-crm');
    }


    // aurora-vet-care
    match /atendimentos_petshop/{docId} {
      allow get, list: if isSiteAdmin('aurora-vet-care');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('aurora-vet-care');
    }


    // grao-nobre-roastery
    match /reservas_cafeteria/{docId} {
      allow get, list: if isSiteAdmin('grao-nobre-roastery');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('grao-nobre-roastery');
    }


    // helios-solar-grid
    match /projetos_energia_solar/{docId} {
      allow get, list: if isSiteAdmin('helios-solar-grid');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('helios-solar-grid');
    }


    // pulse-athletics-hub
    match /reservas_academia/{docId} {
      allow get, list: if isSiteAdmin('pulse-athletics-hub');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('pulse-athletics-hub');
    }


    // valenca-legal-suite
    match /consultas_juridicas/{docId} {
      allow get, list: if isSiteAdmin('valenca-legal-suite');
      allow create: if isValidRecord(request.resource.data);
      allow update, delete: if isSiteAdmin('valenca-legal-suite');
    }

    // Trilha de auditoria: somente o admin do tenant escreve, e registros sao imutaveis.
    match /audit_logs/{tenant}/events/{docId} {
      allow get, list: if isSiteAdmin(tenant);
      allow create: if isSiteAdmin(tenant) && isValidAudit(request.resource.data);
      allow update, delete: if false;
    }

    // Registry: authenticated users may read; only console/admin tooling writes.
    match /site_registry/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
